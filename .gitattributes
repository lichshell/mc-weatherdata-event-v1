# Normalise text files to LF in the repository
* text=auto
*.cmd text eol=crlf

# Java and Maven files
*.java text eol=lf
*.xml  text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Maven Wrapper scripts
mvnw text eol=lf
mvnw.cmd text eol=crlf
/mvnw text eol=lf

